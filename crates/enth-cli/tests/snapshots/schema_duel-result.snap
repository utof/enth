---
source: crates/enth-cli/tests/schemas.rs
expression: v
---
{
  "$defs": {
    "DuelReportedOut": {
      "additionalProperties": false,
      "description": "What a scorecard reports: the sender's app's numbers, never checked.",
      "properties": {
        "assists": {
          "description": "The live meter, \"dim unused\", \"How close am I?\", a reveal after the pass.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hints": {
          "description": "Hints used (15 means \"15 or more\").",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "seconds": {
          "description": "Seconds: the time to pass, or the round's active time without a pass (tenths; at most 6553.5, \"or more\").",
          "format": "double",
          "type": "number"
        },
        "submits": {
          "description": "Submits up to the compared one (1 to 127; 127 means \"127 or more\").",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "submits",
        "seconds",
        "hints",
        "assists"
      ],
      "type": "object"
    },
    "DuelSymbolsOut": {
      "additionalProperties": false,
      "description": "Symbols in a code.",
      "properties": {
        "answer": {
          "description": "The answer code.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "scorecard": {
          "description": "The scorecard (51 with a short challenge).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "scorecard",
        "answer"
      ],
      "type": "object"
    },
    "ScoreOut": {
      "additionalProperties": false,
      "description": "The three percentages of a round's score and its pass decision.",
      "properties": {
        "combined": {
          "description": "Combined %: the challenge's weighted mix of the two.",
          "format": "double",
          "type": "number"
        },
        "pass_mark": {
          "description": "The pass mark, in sound %.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "description": "Whether sound % is at or above the pass mark.",
          "type": "boolean"
        },
        "sound": {
          "description": "Sound %, 0 to 100: how close it sounds. It alone decides `passed`.",
          "format": "double",
          "type": "number"
        },
        "structure": {
          "description": "Structure %, 0 to 100: how close the randomized parameters are.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "sound",
        "structure",
        "combined",
        "pass_mark",
        "passed"
      ],
      "type": "object"
    }
  },
  "$id": "enth.duel-result/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`enth.duel-result/1`: a played patch's two codes. The **scorecard** spoils nothing and is sent when you finish; the\n**answer code** gives the patch away and is sent once your friend has played.",
  "properties": {
    "answer": {
      "description": "The answer code (kind 2): send it after your friend has played.",
      "type": "string"
    },
    "code": {
      "description": "The challenge code (canonical text).",
      "type": "string"
    },
    "message": {
      "description": "The share message, one line each: the two human lines, then the scorecard.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "next": {
      "description": "What to do next.",
      "type": "string"
    },
    "patch": {
      "description": "The patch file played.",
      "type": "string"
    },
    "reported": {
      "$ref": "#/$defs/DuelReportedOut",
      "description": "What the scorecard reports and nobody can check: the submits, the time, the hints."
    },
    "salt": {
      "description": "The answer code's salt, 16 hex digits: 64 bits of OS randomness, or what `--salt` gave. Keep it with the codes:\n`--salt` makes the same answer code again, the one the scorecard's commitment fixed.",
      "type": "string"
    },
    "schema": {
      "const": "enth.duel-result/1",
      "description": "`enth.duel-result/1`.",
      "type": "string"
    },
    "score": {
      "$ref": "#/$defs/ScoreOut",
      "description": "The answer's score on this build: the canonical answer (the patch without its `meta`, labels, macro names and\nslots), which is what a receiver re-scores. Checked on your computer."
    },
    "scorecard": {
      "description": "The scorecard (kind 1): send it now.",
      "type": "string"
    },
    "symbols": {
      "$ref": "#/$defs/DuelSymbolsOut",
      "description": "Symbols in each code (code v1's check symbol included, hyphens not)."
    },
    "warnings": {
      "description": "Differences that did not stop the codes (another engine than a long code's).",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "code",
    "patch",
    "score",
    "message",
    "scorecard",
    "answer",
    "symbols",
    "salt",
    "reported",
    "warnings",
    "next"
  ],
  "title": "DuelResultOut",
  "type": "object"
}
