---
source: crates/enth-cli/tests/schemas.rs
expression: v
---
{
  "$id": "enth.suggest/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`enth.suggest/1`: the coach's hint for a patch against a challenge's target, at one reveal level.\n\nThe fields appear level by level, as in the game: `aspect` and `difference` from level 1, `module` from 2,\n`param` and `turn` from 3, `range` at 4. **Levels 1 to 3 hold no number but `level`, `levels` and `renders`:\nthe target's values are never printed before the last level, and even then as a range around the fix, not the\ntarget's own value.** Asking for a level costs one coach plan (about 25 renders); the same patch gives the same\nanswer at every worker count.",
  "properties": {
    "aspect": {
      "description": "Level 1 on: the aspect that is off (`pitch`, `brightness`, `attack`, `decay`, `sustain`, `release`,\n`noisiness`, `beating`, `tremolo` or `sweep`); absent when `close`.",
      "type": [
        "string",
        "null"
      ]
    },
    "close": {
      "description": "True when nothing measured is off: every level then says so.",
      "type": "boolean"
    },
    "code": {
      "description": "The challenge's code, when it has one (a `--challenge` file made from a custom spec has a long one).",
      "type": [
        "string",
        "null"
      ]
    },
    "difference": {
      "description": "Level 1 on: how your sound differs: `higher`, `lower`, `missing` (the target has it, yours does not) or\n`extra`.",
      "type": [
        "string",
        "null"
      ]
    },
    "hint": {
      "description": "The next command to try.",
      "type": "string"
    },
    "level": {
      "description": "The reveal level asked for, 1 to `levels`.",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "levels": {
      "description": "How many levels there are (4): 1 which aspect, 2 which module, 3 which parameter and which way, 4 a range.",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "measured": {
      "description": "True when the hint comes from a verified render of the solver's fix; false for a named structural\ndifference (a waveform, a mode, a module or a route) or general advice.",
      "type": "boolean"
    },
    "module": {
      "description": "Level 2 on: the module to look at (`filter1`); absent for a region such as the voice settings.",
      "type": [
        "string",
        "null"
      ]
    },
    "param": {
      "description": "Level 3 on: the parameter to change (`filter1.cutoff`).",
      "type": [
        "string",
        "null"
      ]
    },
    "patch": {
      "description": "The patch file that was judged.",
      "type": "string"
    },
    "range": {
      "description": "Level 4: the values the parameter should land between, `[low, high]` as unit strings.",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "renders": {
      "description": "Renders the coach used for this answer (the target's sensitivity and your patch's probes).",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "schema": {
      "const": "enth.suggest/1",
      "description": "`enth.suggest/1`.",
      "type": "string"
    },
    "text": {
      "description": "The hint in plain language, complete at its level.",
      "type": "string"
    },
    "turn": {
      "description": "Level 3 on: `raise` or `lower`; absent for a categorical parameter, which is changed, not turned.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "patch",
    "level",
    "levels",
    "close",
    "measured",
    "text",
    "renders",
    "hint"
  ],
  "title": "SuggestOut",
  "type": "object"
}
