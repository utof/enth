    {
      "desc": "A slow repeating modulator for vibrato, tremolo and sweeps, per voice or shared by all voices.",
      "id_prefix": "lfo",
      "index": 4,
      "key": "lfo",
      "name": "LFO",
      "params": [
        {
          "default": 0.0,
          "default_text": "sine",
          "desc": "The waveform of the modulation.",
          "flags": {
            "automatable": true,
            "modulatable": false,
            "periodic": false,
            "structural": false
          },
          "key": "shape",
          "kind": {
            "items": [
              {
                "desc": "A smooth wave: natural vibrato and tremolo.",
                "key": "sine",
                "name": "Sine"
              },
              {
                "desc": "Linear up and down: even sweeps.",
                "key": "triangle",
                "name": "Triangle"
              },
              {
                "desc": "Rises then drops: repeating swells.",
                "key": "saw_up",
                "name": "Saw up"
              },
              {
                "desc": "Drops then rises: repeating plucks.",
                "key": "saw_down",
                "name": "Saw down"
              },
              {
                "desc": "Jumps between two values: trills and gating.",
                "key": "square",
                "name": "Square"
              },
              {
                "desc": "A new random step every cycle: the classic computer burble.",
                "key": "sample_hold",
                "name": "Sample & hold"
              },
              {
                "desc": "Wanders randomly and smoothly: slow drift and movement.",
                "key": "smooth_random",
                "name": "Smooth random"
              }
            ],
            "type": "enum"
          },
          "name": "Shape",
          "perceptual": null,
          "smoothing": null,
          "tier": "basic",
          "unit": "none"
        },
        {
          "default": 2.0,
          "default_text": "2Hz",
          "desc": "Cycles per second: about 5 Hz for vibrato, under 0.5 Hz for slow sweeps.",
          "flags": {
            "automatable": true,
            "modulatable": true,
            "periodic": false,
            "structural": false
          },
          "key": "rate",
          "kind": {
            "k": null,
            "max": 50.0,
            "min": 0.009999999776482582,
            "scale": "log",
            "type": "float"
          },
          "name": "Rate",
          "perceptual": null,
          "smoothing": {
            "linear_ms": 10.0
          },
          "tier": "basic",
          "unit": "hz"
        },
        {
          "default": 0.0,
          "default_text": "bipolar",
          "desc": "Bipolar swings around the destination's value; unipolar only adds to it.",
          "flags": {
            "automatable": true,
            "modulatable": false,
            "periodic": false,
            "structural": false
          },
          "key": "polarity",
          "kind": {
            "items": [
              {
                "desc": "Swings both above and below the destination's value.",
                "key": "bipolar",
                "name": "Bipolar"
              },
              {
                "desc": "Moves the destination one way only, from its value up by the route depth.",
                "key": "unipolar",
                "name": "Unipolar"
              }
            ],
            "type": "enum"
          },
          "name": "Polarity",
          "perceptual": null,
          "smoothing": null,
          "tier": "intermediate",
          "unit": "none"
        },
        {
          "default": 0.0,
          "default_text": "voice",
          "desc": "One LFO per voice or one global LFO; only a global LFO can modulate effects. Changing it rebuilds the plan.",
          "flags": {
            "automatable": false,
            "modulatable": false,
            "periodic": false,
            "structural": true
          },
          "key": "scope",
          "kind": {
            "items": [
              {
                "desc": "Each note gets its own LFO, started at note-on.",
                "key": "voice",
                "name": "Per voice"
              },
              {
                "desc": "One LFO shared by every note, running from the start; the only kind that may modulate effects.",
                "key": "global",
                "name": "Global"
              }
            ],
            "type": "enum"
          },
          "name": "Scope",
          "perceptual": null,
          "smoothing": null,
          "tier": "intermediate",
          "unit": "none"
        },
        {
          "default": 1.0,
          "default_text": "reset",
          "desc": "How each cycle start is chosen: reset (the phase knob at each note-on), free (random per render seed) or seeded (from seed).",
          "flags": {
            "automatable": true,
            "modulatable": false,
            "periodic": false,
            "structural": false
          },
          "key": "phase_mode",
          "kind": {
            "items": [
              {
                "desc": "Each note starts at a random phase that changes with the render seed, like a free-running analog oscillator.",
                "key": "free",
                "name": "Free"
              },
              {
                "desc": "Every note starts at the phase knob, so attacks are identical and phase relationships are fixed.",
                "key": "reset",
                "name": "Reset"
              },
              {
                "desc": "Each note starts at a random phase drawn from this module's seed, so the patch itself fixes it.",
                "key": "seeded",
                "name": "Seeded"
              }
            ],
            "type": "enum"
          },
          "name": "Phase mode",
          "perceptual": null,
          "smoothing": null,
          "tier": "advanced",
          "unit": "none"
        },
        {
          "default": 0.0,
          "default_text": "0deg",
          "desc": "Where in its cycle the LFO starts in reset mode.",
          "flags": {
            "automatable": true,
            "modulatable": false,
            "periodic": true,
            "structural": false
          },
          "key": "phase",
          "kind": {
            "k": null,
            "max": 360.0,
            "min": 0.0,
            "scale": "linear",
            "type": "float"
          },
          "name": "Start phase",
          "perceptual": null,
          "smoothing": null,
          "tier": "advanced",
          "unit": "degrees"
        },
        {
          "default": 0.0,
          "default_text": "0",
          "desc": "The random seed used in seeded phase mode, including the random shapes.",
          "flags": {
            "automatable": false,
            "modulatable": false,
            "periodic": false,
            "structural": false
          },
          "key": "seed",
          "kind": {
            "max": 65535,
