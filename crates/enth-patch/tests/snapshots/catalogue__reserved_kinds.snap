        "tier": "basic",
        "unit": "hz"
      },
      {
        "default": 0.0,
        "default_text": "0st",
        "desc": "Moves every formant up or down together, keeping the vowel: a smaller, brighter voice or a bigger, darker one.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
