        },
        "tier": "intermediate",
        "unit": "cents"
      },
      {
        "default": 100.0,
        "default_text": "100%",
        "desc": "Level of the side unison copies against the centre one: 0 % is the centre alone, 100 % every copy equal.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "blend",
        "kind": {
          "k": null,
          "max": 100.0,
