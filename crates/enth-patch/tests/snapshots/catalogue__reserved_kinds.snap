      {
        "default": 1.0,
        "default_text": "reset",
        "desc": "How each note's start phase is chosen: reset (the phase knob, the same every note, as FM and warps want), free (random per render seed) or seeded (from seed).",
        "flags": {
          "automatable": true,
          "modulatable": false,
          "periodic": false,
          "structural": false
        },
        "key": "phase_mode",
        "kind": {
          "items": [
            {
              "desc": "Each note starts at a random phase that changes with the render seed, like a free-running analog oscillator.",
              "key": "free",
              "name": "Free"
            },
            {
              "desc": "Every note starts at the phase knob, so attacks are identical and phase relationships are fixed.",
              "key": "reset",
              "name": "Reset"
            },
            {
              "desc": "Each note starts at a random phase drawn from this module's seed, so the patch itself fixes it.",
              "key": "seeded",
              "name": "Seeded"
            }
          ],
          "type": "enum"
