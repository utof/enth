  {
    "desc": "A stereo chorus or flanger after the voices: width and movement from short modulated delays.",
    "id_prefix": "chorus",
    "index": 13,
    "key": "chorus",
    "name": "Chorus",
    "params": [
      {
        "default": 0.0,
        "default_text": "chorus",
        "desc": "The algorithm: chorus, ensemble or flanger.",
        "flags": {
          "automatable": true,
          "modulatable": false,
          "periodic": false,
          "structural": false
        },
        "key": "mode",
        "kind": {
          "items": [
            {
              "desc": "A few slightly delayed, slowly wobbling copies beside the dry sound: width and shimmer.",
              "key": "chorus",
              "name": "Chorus"
            },
            {
              "desc": "A string-machine ensemble: three wobbling copies per side, lush and wide, for pads and big basses.",
              "key": "ensemble",
              "name": "Ensemble"
            },
            {
              "desc": "A very short delay swept against the dry sound: the jet-plane whoosh of moving comb notches.",
              "key": "flanger",
              "name": "Flanger"
            }
          ],
          "type": "enum"
        },
        "name": "Mode",
        "perceptual": null,
        "smoothing": null,
        "tier": "basic",
        "unit": "none"
      },
      {
        "default": 0.5,
        "default_text": "0.5Hz",
        "desc": "How fast the delay sweeps, in cycles per second, when tempo sync is off: slow is a gentle shimmer, fast a warble.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "rate",
        "kind": {
          "k": null,
          "max": 20.0,
