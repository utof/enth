  {
    "desc": "Three-band upward and downward compression after the voices: the loud, dense, bright bass-music sound.",
    "id_prefix": "ott",
    "index": 9,
    "key": "ott",
    "name": "OTT",
    "params": [
      {
        "default": 30.0,
        "default_text": "30%",
        "desc": "How hard all three bands are squashed up and down: 0 % leaves the levels alone, 100 % is the full, dense OTT sound.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "depth",
        "kind": {
          "k": null,
          "max": 100.0,
          "min": 0.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Depth",
        "perceptual": "loudness.lufs_i",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "basic",
