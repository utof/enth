  {
    "desc": "A keytracked comb filter per voice: metallic, resonant tones and plucked strings.",
    "id_prefix": "comb",
    "index": 10,
    "key": "comb",
    "name": "Comb filter",
    "params": [
      {
        "default": 0.0,
        "default_text": "0st",
        "desc": "The comb's pitch in semitones from the played note (from middle C when keytrack is 0 %): +12st puts the teeth an octave up; an LFO here flanges.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "semi",
        "kind": {
          "k": null,
          "max": 48.0,
          "min": -48.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Tune",
        "perceptual": "spectrum.harmonics_db",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "basic",
        "unit": "semitones"
      },
      {
        "default": 100.0,
        "default_text": "100%",
        "desc": "How much the comb's pitch follows the played note: 100 % keeps the teeth on the note's harmonics, 0 % holds a fixed pitch.",
        "flags": {
          "automatable": true,
          "modulatable": false,
          "periodic": false,
          "structural": false
        },
        "key": "keytrack",
        "kind": {
          "k": null,
          "max": 100.0,
          "min": 0.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Key tracking",
        "perceptual": null,
        "smoothing": null,
        "tier": "intermediate",
        "unit": "percent"
      },
      {
        "default": 50.0,
        "default_text": "50%",
        "desc": "How strongly the comb rings: higher is more metallic and longer; negative puts the resonances between the harmonics, hollow and an octave down.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "feedback",
        "kind": {
          "k": null,
          "max": 99.0,
          "min": -99.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Feedback",
        "perceptual": "spectrum.harmonics_db",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "basic",
        "unit": "percent"
      },
      {
        "default": 10000.0,
        "default_text": "10kHz",
        "desc": "A low-pass inside the feedback loop: lower makes the high teeth die faster, for a softer, plucked ring; 20 kHz leaves it bright.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "damping",
        "kind": {
          "k": null,
          "max": 20000.0,
          "min": 500.0,
          "scale": "log",
          "type": "float"
        },
        "name": "Damping",
        "perceptual": "spectrum.centroid_hz",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "intermediate",
        "unit": "hz"
      },
      {
        "default": 100.0,
        "default_text": "100%",
        "desc": "How much of the effect is heard: at 0 % the input passes unchanged; around 50 % the dry signal adds notches between the teeth.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
