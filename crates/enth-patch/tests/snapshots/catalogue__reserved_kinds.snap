  {
    "desc": "A drawn multi-segment envelope or LFO, free or tempo-synced: the wobbles and rhythmic movement of bass music.",
    "id_prefix": "mseg",
    "index": 12,
    "key": "mseg",
    "name": "MSEG",
    "params": [
      {
        "default": 0.0,
        "default_text": "loop",
        "desc": "How the shape plays: loop (a drawn LFO), one-shot (an envelope) or sustain loop (loops while the note is held).",
        "flags": {
          "automatable": true,
          "modulatable": false,
          "periodic": false,
          "structural": false
        },
        "key": "mode",
        "kind": {
          "items": [
            {
              "desc": "Repeats the shape for as long as the note lasts: a drawn LFO for wobbles and rhythms.",
              "key": "loop",
              "name": "Loop"
            },
            {
              "desc": "Plays the shape once from the note's start, then holds the last level: an envelope of any length.",
              "key": "one_shot",
              "name": "One-shot"
            },
            {
              "desc": "Plays to the loop end, loops between loop start and loop end while the note is held, then plays the rest after release.",
              "key": "sustain_loop",
              "name": "Sustain loop"
            }
          ],
          "type": "enum"
        },
        "name": "Mode",
        "perceptual": null,
        "smoothing": null,
        "tier": "basic",
        "unit": "none"
      },
      {
        "default": 1.0,
        "default_text": "on",
        "desc": "On: the shape's length is beats of the song's tempo. Off: it is length, in milliseconds.",
        "flags": {
          "automatable": true,
          "modulatable": false,
          "periodic": false,
          "structural": false
        },
        "key": "sync",
        "kind": {
