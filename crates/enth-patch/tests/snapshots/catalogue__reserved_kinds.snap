            {
              "desc": "An eighth note: half a beat.",
              "key": "eighth",
              "name": "1/8"
            },
            {
              "desc": "A quarter-note triplet: two thirds of a beat.",
              "key": "quarter_triplet",
              "name": "1/4T"
            },
            {
              "desc": "A dotted eighth note: three quarters of a beat, a syncopated bounce.",
              "key": "eighth_dotted",
              "name": "1/8D"
            },
            {
              "desc": "A quarter note: one beat.",
              "key": "quarter",
              "name": "1/4"
            },
            {
              "desc": "A half-note triplet: four thirds of a beat.",
              "key": "half_triplet",
              "name": "1/2T"
            },
            {
              "desc": "A dotted quarter note: a beat and a half.",
              "key": "quarter_dotted",
              "name": "1/4D"
            },
            {
              "desc": "A half note: two beats.",
              "key": "half",
              "name": "1/2"
            },
            {
              "desc": "A whole-note triplet: two thirds of a bar.",
