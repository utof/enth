            },
            {
              "desc": "A thirty-second note: an eighth of a beat.",
              "key": "thirty_second",
              "name": "1/32"
            },
            {
              "desc": "A sixteenth-note triplet: a sixth of a beat.",
              "key": "sixteenth_triplet",
              "name": "1/16T"
            },
            {
              "desc": "A dotted thirty-second note: three sixteenths of a beat.",
              "key": "thirty_second_dotted",
              "name": "1/32D"
            },
            {
              "desc": "A sixteenth note: a quarter of a beat.",
              "key": "sixteenth",
