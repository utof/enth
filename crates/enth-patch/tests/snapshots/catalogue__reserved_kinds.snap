        "perceptual": null,
        "smoothing": null,
        "tier": "intermediate",
        "unit": "none"
      },
      {
        "default": 20.0,
        "default_text": "+20ct",
        "desc": "How far the outermost unison copies sit from the centre, in cents (±): small values thicken, large ones sound like a detuned chord.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "detune",
        "kind": {
