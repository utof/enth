source: crates/enth-patch/tests/catalogue.rs
expression: reserved
---
[
  {
    "desc": "Per-voice distortion: clipping, wavefolding, bitcrushing and downsampling, blended with the dry signal.",
    "id_prefix": "dist",
    "index": 7,
    "key": "dist",
    "name": "Distortion",
    "params": [
      {
        "default": 0.0,
        "default_text": "soft",
        "desc": "The distortion curve: soft or hard clipping, asymmetric, sine or triangle folding, bitcrush or downsample.",
        "flags": {
          "automatable": true,
          "modulatable": false,
          "periodic": false,
          "structural": false
        },
        "key": "mode",
        "kind": {
          "items": [
            {
              "desc": "Rounds off the peaks smoothly: warm saturation that grows with drive.",
              "key": "soft",
              "name": "Soft clip"
            },
            {
              "desc": "Cuts the peaks flat: bright, buzzy and aggressive.",
              "key": "hard",
              "name": "Hard clip"
            },
            {
              "desc": "Clips the top and bottom differently, like a tube or a diode: thicker, with even harmonics.",
              "key": "asym",
              "name": "Asymmetric"
            },
            {
              "desc": "Folds the wave back on itself in smooth curves: rich, metallic and vocal as drive rises.",
              "key": "sine_fold",
              "name": "Sine fold"
            },
            {
              "desc": "Folds the wave back at sharp corners: brighter and buzzier than the sine fold.",
              "key": "tri_fold",
              "name": "Triangle fold"
            },
            {
              "desc": "Fewer volume steps, set by bits: gritty digital noise that follows the signal.",
              "key": "bitcrush",
              "name": "Bitcrush"
            },
            {
              "desc": "Holds each sample for longer, set by rate: metallic, aliased tones and robotic vowels.",
              "key": "downsample",
              "name": "Downsample"
            }
          ],
          "type": "enum"
        },
        "name": "Mode",
        "perceptual": "spectrum.harmonics_db",
        "smoothing": null,
        "tier": "basic",
        "unit": "none"
      },
      {
        "default": 6.0,
        "default_text": "6dB",
        "desc": "Gain into the curve: more drive is more distortion; route an LFO or MSEG here for rhythmic grit.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "drive",
        "kind": {
          "k": null,
          "max": 48.0,
          "min": 0.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Drive",
        "perceptual": "spectrum.harmonics_db",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "basic",
        "unit": "db"
      },
      {
        "default": 0.0,
        "default_text": "0%",
        "desc": "An offset added before the curve, so the top and bottom distort differently: adds even harmonics and a thicker, rasping tone.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "bias",
        "kind": {
          "k": null,
          "max": 100.0,
          "min": -100.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Bias",
        "perceptual": null,
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "intermediate",
        "unit": "percent"
      },
      {
        "default": 8.0,
        "default_text": "8",
        "desc": "Bit depth in bitcrush mode, fractions allowed: 16 is clean, 8 is gritty, 2 is a buzz. Other modes ignore it.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "bits",
        "kind": {
          "k": null,
          "max": 16.0,
          "min": 1.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Bits",
        "perceptual": null,
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "intermediate",
        "unit": "none"
      },
      {
        "default": 6000.0,
        "default_text": "6kHz",
        "desc": "The held sample rate in downsample mode: lower is more metallic and aliased; at the engine's rate or above it does nothing. Other modes ignore it.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "rate",
        "kind": {
          "k": null,
          "max": 48000.0,
          "min": 100.0,
          "scale": "log",
          "type": "float"
        },
        "name": "Rate",
        "perceptual": null,
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "intermediate",
        "unit": "hz"
      },
      {
        "default": 20000.0,
        "default_text": "20kHz",
        "desc": "A low-pass after the curve that tames fizz: lower is darker; 20 kHz leaves it open.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "tone",
        "kind": {
          "k": null,
          "max": 20000.0,
          "min": 100.0,
          "scale": "log",
          "type": "float"
        },
        "name": "Tone",
        "perceptual": "spectrum.centroid_hz",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "intermediate",
        "unit": "hz"
      },
      {
        "default": 20.0,
        "default_text": "20Hz",
        "desc": "Frequencies below this bypass the distortion, so the sub stays clean and only the mids distort; at 20 Hz everything is distorted.",
        "flags": {
          "automatable": true,
          "modulatable": false,
          "periodic": false,
          "structural": false
        },
        "key": "keep_lows",
        "kind": {
          "k": null,
          "max": 1000.0,
          "min": 20.0,
          "scale": "log",
          "type": "float"
        },
        "name": "Keep lows",
        "perceptual": null,
        "smoothing": null,
        "tier": "intermediate",
        "unit": "hz"
      },
      {
        "default": 1.0,
        "default_text": "x2",
        "desc": "How much the clipping and folding curves are oversampled to cut aliasing: off, 2x or 4x (no latency either way); changing it rebuilds the plan.",
        "flags": {
          "automatable": false,
          "modulatable": false,
          "periodic": false,
          "structural": true
        },
        "key": "oversample",
        "kind": {
          "items": [
            {
              "desc": "No oversampling, the lightest on the CPU; anti-derivative anti-aliasing still applies.",
              "key": "off",
              "name": "Off"
            },
            {
              "desc": "Runs the curve at twice the sample rate: much less aliasing on high notes, for a little CPU.",
              "key": "x2",
              "name": "2x"
            },
            {
              "desc": "Runs the curve at four times the sample rate: the cleanest, at about twice the cost of 2x.",
              "key": "x4",
              "name": "4x"
            }
          ],
          "type": "enum"
        },
        "name": "Oversampling",
        "perceptual": null,
        "smoothing": null,
        "tier": "advanced",
        "unit": "none"
      },
      {
        "default": 100.0,
        "default_text": "100%",
        "desc": "How much of the effect is heard: at 0 % the input passes unchanged; lower values blend in the clean signal (parallel distortion).",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "mix",
        "kind": {
          "k": null,
          "max": 100.0,
          "min": 0.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Mix",
        "perceptual": null,
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "intermediate",
        "unit": "percent"
      }
    ],
    "section": "voice_fx",
    "tier": "intermediate",
    "time_based": false
  },
  {
    "desc": "A wavetable oscillator whose phase or amplitude another source can modulate: FM, PM, AM and ring modulation.",
    "id_prefix": "wt",
    "index": 8,
    "key": "wt",
    "name": "Wavetable",
    "params": [
      {
        "default": 0.0,
        "default_text": "basic",
        "desc": "Which generated wavetable to play: basic shapes, FM sweeps, a formant sweep or sparse metal; changing it rebuilds the voice plan.",
        "flags": {
          "automatable": false,
          "modulatable": false,
          "periodic": false,
          "structural": true
        },
        "key": "table",
        "kind": {
          "items": [
            {
              "desc": "Morphs sine, triangle, saw and square; at position 0 it is a pure sine, the classic FM operator.",
              "key": "basic",
              "name": "Basic"
            },
            {
              "desc": "Two-operator FM at a 1:1 ratio, the index rising with position: a growl you scan instead of route.",
              "key": "fm",
              "name": "FM sweep"
            },
            {
              "desc": "Two-operator FM with the modulator an octave up, the index rising with position: hollow, reedy tones.",
              "key": "fm_octave",
              "name": "FM sweep, octave"
            },
            {
              "desc": "A saw with one vocal resonance that rises with position: scanning it says 'wow' and 'yoi'.",
              "key": "formant",
              "name": "Formant sweep"
            },
            {
              "desc": "A few strong, widely spaced harmonics: clangy, robotic tones that grow denser with position.",
              "key": "metal",
              "name": "Sparse metal"
            }
          ],
          "type": "enum"
        },
        "name": "Wavetable",
        "perceptual": "spectrum.harmonics_db",
        "smoothing": null,
        "tier": "basic",
        "unit": "none"
      },
      {
        "default": 0.0,
        "default_text": "0%",
        "desc": "Where in the wavetable to play, from its first frame to its last; route an LFO or MSEG here for moving timbres.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "position",
        "kind": {
          "k": null,
          "max": 100.0,
          "min": 0.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Position",
        "perceptual": "spectrum.centroid_hz",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "basic",
        "unit": "percent"
      },
      {
        "default": 0.0,
        "default_text": "off",
        "desc": "How the wave's cycle is bent before it is read: bend, asymmetric bend, squeeze, sync or quantize.",
        "flags": {
          "automatable": true,
          "modulatable": false,
          "periodic": false,
          "structural": false
        },
        "key": "warp",
        "kind": {
          "items": [
            {
              "desc": "The table is read straight.",
              "key": "off",
              "name": "Off"
            },
            {
              "desc": "Bends the cycle so the wave's detail bunches up at the start (positive) or the end (negative): brighter, nasal tones.",
              "key": "bend",
              "name": "Bend"
            },
            {
              "desc": "Bends the two halves of the cycle in opposite directions: a pulse-width-like change for any wave.",
              "key": "asym",
              "name": "Asymmetric bend"
            },
            {
              "desc": "Plays the whole cycle in a shorter part of the period and holds the rest: a thinner, pulse-like buzz.",
              "key": "squeeze",
              "name": "Squeeze"
            },
            {
              "desc": "Reads the cycle several times per period and restarts it, like hard sync: tearing, vocal sweeps.",
              "key": "sync",
              "name": "Sync"
            },
            {
              "desc": "Reads the cycle in steps: stepped, lo-fi versions of the wave.",
              "key": "quantize",
              "name": "Quantize"
            }
          ],
          "type": "enum"
        },
        "name": "Warp",
        "perceptual": "spectrum.harmonics_db",
        "smoothing": null,
        "tier": "intermediate",
        "unit": "none"
      },
      {
        "default": 0.0,
        "default_text": "0%",
        "desc": "How strongly the warp bends the cycle: 0 % leaves it straight; the sign flips the direction where the warp has one.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "warp_amount",
        "kind": {
          "k": null,
          "max": 100.0,
          "min": -100.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Warp amount",
        "perceptual": "spectrum.centroid_hz",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "intermediate",
        "unit": "percent"
      },
      {
        "default": 0.0,
        "default_text": "0st",
        "desc": "Transposition in semitones from the played note; as an FM modulator, +12st is a 1:2 ratio and +19.02st a 1:3.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "semi",
        "kind": {
          "k": null,
          "max": 48.0,
          "min": -48.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Semitones",
        "perceptual": "pitch.f0_hz",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "basic",
        "unit": "semitones"
      },
      {
        "default": 0.0,
        "default_text": "0ct",
        "desc": "Fine tuning in cents; a few cents off a 1:1 FM ratio makes the timbre slowly churn.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "fine",
        "kind": {
          "k": null,
          "max": 100.0,
          "min": -100.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Fine",
        "perceptual": "detune.beating_hz",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "basic",
        "unit": "cents"
      },
      {
        "default": 100.0,
        "default_text": "100%",
        "desc": "Output level into the voice, as a linear percentage; at 0 % an FM modulator is silent but still modulates.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "level",
        "kind": {
          "k": null,
          "max": 100.0,
          "min": 0.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Level",
        "perceptual": "loudness.lufs_i",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "basic",
        "unit": "percent"
      },
      {
        "default": 100.0,
        "default_text": "100%",
        "desc": "Where audio routes from other generators land for phase modulation (FM); its value trims everything routed in: 100 % passes the route depths as set, 0 % turns PM off.",
        "flags": {
          "audio": true,
          "automatable": true,
          "modulatable": false,
          "periodic": false,
          "structural": false
        },
        "key": "pm",
        "kind": {
          "k": null,
          "max": 100.0,
          "min": 0.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "PM input",
        "perceptual": null,
        "smoothing": null,
        "tier": "advanced",
        "unit": "percent"
      },
      {
        "default": 1.0,
        "default_text": "1",
        "desc": "How far a full-scale input into pm bends the phase, in radians: 1 is gentle, 5 a growl, 10 a harsh clang; route an envelope or MSEG here to make it talk.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "pm_index",
        "kind": {
          "k": null,
          "max": 10.0,
          "min": 0.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "PM index",
        "perceptual": "spectrum.harmonics_db",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "intermediate",
        "unit": "none"
      },
      {
        "default": 100.0,
        "default_text": "100%",
        "desc": "Where audio routes from other generators land for amplitude modulation; its value is the gain they swing around: 100 % is AM, 0 % is ring modulation (without a route it scales the output).",
        "flags": {
          "audio": true,
          "automatable": true,
          "modulatable": false,
          "periodic": false,
          "structural": false
        },
        "key": "am",
        "kind": {
          "k": null,
          "max": 100.0,
          "min": 0.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "AM input",
        "perceptual": null,
        "smoothing": null,
        "tier": "intermediate",
        "unit": "percent"
      },
      {
        "default": 0.0,
        "default_text": "0%",
        "desc": "Phase modulation of the oscillator by its own output: a sine turns towards a saw, then a rough, noisy edge.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "feedback",
        "kind": {
          "k": null,
          "max": 100.0,
          "min": 0.0,
          "scale": "linear",
          "type": "float"
        },
        "name": "Feedback",
        "perceptual": "spectrum.harmonics_db",
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "intermediate",
        "unit": "percent"
      },
      {
        "default": 1.0,
        "default_text": "1",
        "desc": "Copies of the oscillator per voice (1 is off), detuned against each other for width and thickness; changing it rebuilds the plan.",
        "flags": {
          "automatable": false,
          "modulatable": false,
          "periodic": false,
          "structural": true
        },
        "key": "unison",
        "kind": {
