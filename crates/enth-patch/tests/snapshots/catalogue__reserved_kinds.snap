      },
      {
        "default": 1610.0,
        "default_text": "1.61kHz",
        "desc": "The second formant: how far forward the vowel is, from 'oo' (about 600 Hz) through 'ah' (1.6 kHz) to 'ee' (2.4 kHz); sweep it for 'yoi' and 'wow'.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
        },
        "key": "f2",
        "kind": {
