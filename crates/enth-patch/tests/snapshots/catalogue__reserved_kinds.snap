      {
        "default": 50.0,
        "default_text": "50%",
        "desc": "How far the delay sweeps: more is a deeper wobble in pitch (chorus) or a wider sweep of the notches (flanger).",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
          "structural": false
