          "scale": "linear",
          "type": "float"
        },
        "name": "Blend",
        "perceptual": null,
        "smoothing": {
          "linear_ms": 10.0
        },
        "tier": "advanced",
        "unit": "percent"
      },
      {
        "default": 50.0,
        "default_text": "50%",
        "desc": "How widely the unison copies are spread across the stereo field: 0 % is mono, 100 % fully left and right.",
        "flags": {
          "automatable": true,
          "modulatable": true,
          "periodic": false,
