# Proptest appends one `cc <hash> # shrinks to ...` line per failure it finds. Two lanes adding different lines to
# the same file must not conflict: keep the union of both sides.
**/proptest-regressions/**/*.txt merge=union
**/proptest-regressions/*.txt merge=union

# Golden challenge pins are compared as text: keep LF on every platform (lane GC).
tests/golden/challenges/** text eol=lf

# The generator and structure goldens are compared as whole text too (`include_str!` == computed): keep LF, or a
# Windows checkout (core.autocrlf) turns every line into CRLF and the test fails with "0 of 1003 lines differ"
# (golden.yml's Windows job on e47543f; R1/S1 lane INT).
tests/golden/generator/** text eol=lf
tests/golden/structure/** text eol=lf
# The same for Challenge v2's draw golden (golden.yml's Windows job on bede6d9 and 0b428c8).
tests/golden/draw/** text eol=lf
# Text pins read with `include_str!` and compared or hashed as text: the model contract's layout, generator v1's
# catalogue and the reverb fixtures (golden.yml's Windows job failed `the_v1_layout_is_pinned` on 5082fec).
crates/enth-solver/src/propose/layout-v1.txt text eol=lf
crates/enth-challenge/src/random/catalogue-v1.txt text eol=lf
crates/enth-dsp/tests/fixtures/*.txt text eol=lf

# Lesson packs are hashed byte for byte (a pack's manifest lists each file's SHA-256, `cargo xtask pack` builds it
# reproducibly, and `lesson-check` compares the patches with `Patch::to_json()` as text): keep LF on every platform, or a
# Windows checkout (core.autocrlf) changes every hash (lane S0l, R2).
content/lessons/** text eol=lf

# GR3's held-out sets are hashed byte for byte (`hashes.txt` lists the SHA-256 of each set file, and the exclusion lists are
# compared as text): keep LF on every platform, or a Windows checkout (core.autocrlf) changes every hash (lane S0s, R3).
# `text=auto` so a clip (audio is committed only when it is CC0 or the owner's) is never rewritten.
content/gr3/** text=auto eol=lf
content/gr3/**/*.wav binary
content/gr3/**/*.flac binary
content/gr3/**/*.mp3 binary
content/gr3/**/*.ogg binary
content/gr3/**/*.aif binary
content/gr3/**/*.aiff binary

# ml/ is Python and text, LF everywhere (a script that fails on a CRLF shebang is a bad afternoon). `text=auto` so a binary
# artefact somebody commits by choice (a tiny fixture, a model file) is left alone.
ml/** text=auto eol=lf
