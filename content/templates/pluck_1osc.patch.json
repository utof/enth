{
  "schema": 1,
  "meta": {
    "name": "Pluck (1 osc)",
    "description": "A saw through a low-pass that a quick envelope (env2, about +4 octaves) throws open at the attack and lets close again: bright at the start, dark by the tail. A short pluck to shape.",
    "tags": ["pluck"]
  },
  "voice": { "amp_env": "env1" },
  "generators": [
    { "id": "osc1", "kind": "osc", "params": { "wave": "saw" } }
  ],
  "voice_fx": [
    { "id": "filter1", "kind": "svf", "params": { "mode": "lp", "cutoff": 1000, "resonance": 15 } }
  ],
  "modulators": [
    { "id": "env1", "kind": "adsr", "params": { "attack": 1, "decay": 350, "sustain": 0, "release": 150 } },
    { "id": "env2", "kind": "adsr", "params": { "attack": 1, "decay": 220, "sustain": 0, "release": 150 } }
  ],
  "routes": [
    { "src": "env2", "dst": "filter1.cutoff", "depth": 45 }
  ]
}
