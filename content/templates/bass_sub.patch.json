{
  "schema": 1,
  "meta": {
    "name": "Sub bass",
    "description": "A saw over a sine an octave below through a dark resonant low-pass, with a fast attack and a full sustain. Mono, and notes played legato slide into each other over 40 ms. The master level is -6 dB so the sub does not clip.",
    "tags": ["bass"]
  },
  "voice": { "mode": "mono", "glide": 40, "glide_mode": "legato", "amp_env": "env1" },
  "master": { "level": -6 },
  "generators": [
    { "id": "osc1", "kind": "osc", "params": { "wave": "saw", "level": 70 } },
    { "id": "osc2", "kind": "osc", "params": { "wave": "sine", "semi": -12, "level": 100 } }
  ],
  "voice_fx": [
    { "id": "filter1", "kind": "svf", "params": { "mode": "lp", "cutoff": 500, "resonance": 25 } }
  ],
  "modulators": [
    { "id": "env1", "kind": "adsr", "params": { "attack": 2, "decay": 300, "sustain": 80, "release": 120 } }
  ]
}
