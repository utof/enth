    {
      "id": "lfo1",
      "kind": "lfo",
      "params": {
        "shape": "triangle",
        "sync": true,
        "beats": "bar"
      }
    }
  ],
  "fx": [
    {
      "id": "phaser1",
      "kind": "phaser",
      "params": {
        "stages": 6,
        "rate": 0.2,
        "feedback": 50,
        "mix": 40
      }
    }
  ],
  "routes": [
