{
  "schema": 1,
  "meta": {
    "name": "FM bass",
    "description": "A wavetable phase-modulated by a silent sine an octave up (ratio 1:2) whose index an envelope sweeps down over 1.5 s, which also opens a 24 dB low-pass; hard clipping that spares the lows and a compressor. Mono, legato. The FM and foghorn basses of report 04 (S9).",
    "tags": ["bass", "fm"]
  },
  "voice": { "mode": "legato", "polyphony": 1, "glide": 20, "amp_env": "env1" },
  "generators": [
    { "id": "wt1", "kind": "wt", "params": { "table": "basic", "pm_index": 3 } },
    { "id": "osc2", "kind": "osc", "params": { "wave": "sine", "semi": 12, "level": 0 } }
  ],
  "voice_fx": [
    { "id": "ladder1", "kind": "ladder", "params": { "mode": "lp24", "cutoff": 500, "resonance": 20 } },
    { "id": "dist1", "kind": "dist", "params": { "mode": "hard", "drive": 12, "keep_lows": 150 } }
  ],
  "modulators": [
    { "id": "env1", "kind": "adsr", "params": { "attack": 2, "decay": 300, "sustain": 100, "release": 300 } },
    { "id": "env2", "kind": "adsr", "params": { "attack": 10, "decay": 1500, "sustain": 0, "release": 300 } }
  ],
  "fx": [
    { "id": "comp1", "kind": "comp", "params": { "threshold": -24, "ratio": 4 } }
  ],
  "routes": [
    { "src": "osc2", "dst": "wt1.pm", "depth": 100 },
    { "src": "env2", "dst": "wt1.pm_index", "depth": 40 },
    { "src": "env2", "dst": "ladder1.cutoff", "depth": 25 }
  ]
}
