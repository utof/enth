  "routes": [
    {
      "src": "osc2",
      "dst": "wt1.pm",
      "depth": 100
    },
    {
      "src": "env2",
      "dst": "ladder1.cutoff",
      "depth": 30
    },
    {
      "src": "env2",
      "dst": "wt1.position",
      "depth": 15
    },
    {
      "src": "env2",
      "dst": "wt1.pm_index",
      "depth": 20
    }
  ]
